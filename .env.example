# =============================================
# Power Tool Tracking - Environment Configuration
# Copy this file and fill in actual values.
# DO NOT commit .env.dev / .env.uat / .env.prod
# =============================================

# API Configuration
API_BASE_URL=https://api.your-domain.com
API_TIMEOUT=30000

# App Identity
APP_NAME=Power Tool Tracking
FLAVOR=PROD

# Google Maps
GOOGLE_MAP_KEY=

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# SSL Pinning (comma-separated SHA-256 hashes)
SSL_PINS=

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_REMOTE_CONFIG=true

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
OFFLINE_CACHE_DAYS=30
